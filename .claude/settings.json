{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm run typecheck)",
      "Bash(npm run typecheck:node)",
      "Bash(npm run typecheck:web)",
      "Bash(npm run lint)",
      "Bash(npm run build)",
      "Bash(npm run format)",
      "Bash(npx eslint *)",
      "Bash(npx prettier *)",
      "Bash(npx tsc --noEmit *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git worktree list)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Bash(npm install *)",
      "Bash(npm i *)",
      "Bash(npm update *)"
    ]
  }
}
